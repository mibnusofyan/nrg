  <step>
    <name>S1 item</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_ecom</connection>
    <sql>SELECT oi.order_item_id, oi.order_id, oi.line_no, o.customer_id, o.order_ts, o.status,
       o.voucher_id, oi.sku, oi.qty, oi.unit_price, oi.disc_amount,
       COALESCE(r.qty, 0)           AS qty_retur,
       COALESCE(r.refund_amount, 0) AS refund_amount
FROM order_items oi
JOIN orders o ON o.order_id = oi.order_id
LEFT JOIN order_returns r ON r.order_item_id = oi.order_item_id AND r.status = 'DISETUJUI'
ORDER BY oi.order_item_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
