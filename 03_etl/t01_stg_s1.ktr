    <sql>SELECT p.sku, p.product_name, p.brand,
       induk.category_name AS kategori,
       sub.category_name   AS sub_kategori
FROM products p
JOIN categories sub ON sub.category_id = p.category_id
LEFT JOIN categories induk ON induk.category_id = sub.parent_category_id
ORDER BY p.sku</sql>
