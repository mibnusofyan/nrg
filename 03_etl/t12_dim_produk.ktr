    <connection>conn_stg</connection>
    <sql>SELECT p.sku AS material_no, p.product_name AS nama_produk, p.brand, p.kategori, p.sub_kategori
FROM stg_s1_produk p
JOIN nrg_dw.map_produk m ON m.sumber_sistem = 'S1' AND m.kode_produk_sumber = p.sku
WHERE m.material_no IS NULL</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
